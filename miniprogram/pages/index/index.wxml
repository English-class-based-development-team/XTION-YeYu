<!--pages/index/index.wxml-->
<view class="page-container">
  <!-- 顶部导航按钮 -->
  <view class="top-nav" style="padding-top: {{statusBarHeight}}px;">
    <!-- 左上角 Profile 按钮 -->
    <view class="nav-button" bindtap="onProfileClick">
      <view class="nav-icon">
        <image class="nav-icon-image" src="/images/icons/user.svg" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 右上角 Search 按钮 -->
    <view class="nav-button" bindtap="onSearchClick">
      <view class="nav-icon">
        <image class="nav-icon-image" src="/images/icons/search.svg" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- 标题区域 -->
  <view class="header-section">
    <view class="main-title">夜语</view>
    <view class="subtitle">你的情绪共鸣空间</view>
  </view>

  <!-- DriftBottle 容器（居中） -->
  <view class="bottle-container">
    <drift-bottle bindclick="onDriftBottleClick"></drift-bottle>
  </view>

  <!-- 底部 ChatInterface -->
  <view class="chat-container">
    <!-- ProactiveCare 组件 - 显示在聊天界面上方 -->
    <proactive-care
      id="proactiveCare"
      wx:if="{{showProactiveCare}}"
      show="{{showProactiveCare}}"
      userId="{{userId}}"
      username="{{username}}"
      bindmessageclick="onProactiveCareMessageClick"
    ></proactive-care>
    
    <chat-interface 
      messages="{{chatMessages}}"
      showMessages="{{true}}"
      bindsend="onChatSend"
      bindmessageupdate="onChatMessageUpdate"
      bindopenfullscreen="onOpenFullscreenChat"
    ></chat-interface>
  </view>

  <!-- CreateMessageCard 模态框 -->
  <create-message-card
    wx:if="{{showCreateMessageCard}}"
    show="{{showCreateMessageCard}}"
    userId="{{userId}}"
    username="{{username}}"
    bindclose="onCloseCreateMessageCard"
    bindsend="onCreateMessageSend"
    bindpostpublished="onPostPublished"
  ></create-message-card>

  <!-- FullscreenChat 模态框 -->
  <fullscreen-chat
    wx:if="{{showFullscreenChat}}"
    show="{{showFullscreenChat}}"
    initialMessages="{{chatMessages}}"
    userId="{{userId}}"
    username="{{username}}"
    bindclose="onCloseFullscreenChat"
    bindmessagesupdate="onChatMessagesUpdate"
    bindstartresonance="onStartResonance"
    bindpostpublished="onPostPublished"
  ></fullscreen-chat>

  <!-- ResonanceWall 模态框 -->
  <resonance-wall
    wx:if="{{showResonanceWall}}"
    show="{{showResonanceWall}}"
    userTag="{{userEmotion.tag}}"
    userContent="{{userEmotion.content}}"
    bindcomplete="onCloseResonanceWall"
  ></resonance-wall>
</view>