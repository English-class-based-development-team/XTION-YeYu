<!--pages/index/index.wxml-->
<view class="page-container">
  <!-- 顶部导航按钮 -->
  <view class="top-nav" style="padding-top: {{statusBarHeight}}px;">
    <!-- 左上角 Profile 按钮 -->
    <view class="nav-button" bindtap="onProfileClick">
      <view class="nav-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#2a1a4d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="12" cy="7" r="4" stroke="#2a1a4d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </view>
    </view>

    <!-- 右上角 Search 按钮 -->
    <view class="nav-button" bindtap="onSearchClick">
      <view class="nav-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="8" stroke="#2a1a4d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="m21 21-4.35-4.35" stroke="#2a1a4d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </view>
    </view>
  </view>

  <!-- 标题区域 -->
  <view class="header-section">
    <view class="main-title">夜语</view>
    <view class="subtitle">你的情绪共鸣空间</view>
  </view>

  <!-- DriftBottle 容器（居中） -->
  <view class="bottle-container">
    <drift-bottle bindclick="onDriftBottleClick"></drift-bottle>
  </view>

  <!-- 底部 ChatInterface -->
  <view class="chat-container">
    <!-- ProactiveCare 组件 - 显示在聊天界面上方 -->
    <proactive-care
      id="proactiveCare"
      wx:if="{{showProactiveCare}}"
      show="{{showProactiveCare}}"
      userId="{{userId}}"
      username="{{username}}"
    ></proactive-care>
    
    <chat-interface 
      messages="{{chatMessages}}"
      bindsend="onChatSend"
    ></chat-interface>
  </view>

  <!-- CreateMessageCard 模态框 -->
  <create-message-card
    wx:if="{{showCreateMessageCard}}"
    show="{{showCreateMessageCard}}"
    bindclose="onCloseCreateMessageCard"
    bindsend="onCreateMessageSend"
  ></create-message-card>

  <!-- FullscreenChat 模态框 -->
  <fullscreen-chat
    wx:if="{{showFullscreenChat}}"
    show="{{showFullscreenChat}}"
    initialMessages="{{chatMessages}}"
    userId="{{userId}}"
    username="{{username}}"
    bindclose="onCloseFullscreenChat"
    bindmessagesupdate="onChatMessagesUpdate"
    bindpostpublished="onPostPublished"
  ></fullscreen-chat>

  <!-- ResonanceWall 模态框 -->
  <resonance-wall
    wx:if="{{showResonanceWall}}"
    show="{{showResonanceWall}}"
    userTag="{{userEmotion.tag}}"
    userContent="{{userEmotion.content}}"
    bindcomplete="onCloseResonanceWall"
  ></resonance-wall>
</view>