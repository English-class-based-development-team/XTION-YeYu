/* pages/index/index.wxss */

page {
  background-color: #fef8f3;
  height: 100%;
}

.page-container {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fef8f3;
}

/* 顶部导航按钮 */
.top-nav {
  position: fixed;
  top: 0;
  left: 32rpx; /* 固定在左侧 */
  z-index: 10;
  display: flex;
  flex-direction: row; /* 横向排列 */
  align-items: center; /* 垂直中线对齐 */
  gap: 16rpx; /* 减小按钮之间的间距，让搜索按钮左移 */
  padding-top: 48rpx;
}

.nav-button {
  width: 96rpx; /* 圆形按钮默认大小 */
  height: 96rpx;
  border-radius: 50%; /* 完全圆形 */
  box-shadow: 0 4rpx 12rpx rgba(42, 26, 77, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 第一个按钮（Profile）- 深紫灰色，更小 */
.nav-button:first-child {
  width: 80rpx; /* 调小个人信息按钮 */
  height: 80rpx;
  background: linear-gradient(135deg, #5B5F7E 0%, #4A4E6D 100%);
}

.nav-button:first-child .nav-icon-image {
  width: 32rpx; /* 相应调小图标 */
  height: 32rpx;
  filter: brightness(0) invert(1); /* 白色图标 */
}

/* 第二个按钮（Search）- 白色背景 */
.nav-button:last-child {
  background: white;
}

.nav-button:last-child .nav-icon-image {
  filter: none; /* 保持原色或使用深色 */
  opacity: 0.7;
}

.nav-button:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(42, 26, 77, 0.12);
}

.nav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-image {
  width: 40rpx; /* 调整图标大小 */
  height: 40rpx;
}

/* 标题区域 */
.header-section {
  padding: 240rpx 48rpx 48rpx 48rpx; /* 恢复标准padding */
  text-align: left;
}

.main-title {
  color: #2a1a4d;
  font-size: 88rpx; /* 增大主标题字号 */
  font-weight: 700;
  margin-bottom: 16rpx; /* 增加间距 */
  letter-spacing: 2rpx; /* 字间距 */
}

.subtitle {
  color: rgba(42, 26, 77, 0.5);
  font-size: 28rpx; /* 减小副标题字号，形成对比 */
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* DriftBottle 容器（居中） */
.bottle-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

/* 底部 ChatInterface */
.chat-container {
  position: relative;
  z-index: 20;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
}