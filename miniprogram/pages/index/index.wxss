/* pages/index/index.wxss */

page {
  background-color: #fef8f3;
  height: 100%;
}

.page-container {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fef8f3;
}

/* 顶部导航按钮 */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  padding: 48rpx;
  padding-top: 48rpx;
}

.nav-button {
  width: 112rpx; /* w-14 = 56px × 2 */
  height: 112rpx; /* h-14 = 56px × 2 */
  background: white;
  border-radius: 36rpx; /* rounded-[18px] = 18px × 2 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.nav-button:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.nav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-user,
.icon-search {
  font-size: 48rpx; /* w-6 = 24px × 2 */
  line-height: 1;
}

/* 标题区域 */
.header-section {
  padding: 192rpx 48rpx 48rpx 48rpx; /* pt-24 = 96px × 2 = 192rpx, pb-6 = 24px × 2 = 48rpx, px-6 = 24px × 2 = 48rpx */
  text-align: left;
}

.main-title {
  color: #2a1a4d;
  font-size: 72rpx; /* text-4xl = 36px × 2 */
  font-weight: 700;
  margin-bottom: 8rpx; /* mb-1 = 4px × 2 */
}

.subtitle {
  color: rgba(42, 26, 77, 0.6);
  font-size: 36rpx; /* text-lg = 18px × 2 */
  font-weight: 400;
}

/* DriftBottle 容器（居中） */
.bottle-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

/* 底部 ChatInterface */
.chat-container {
  position: relative;
  z-index: 20;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
}