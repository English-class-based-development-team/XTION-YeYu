<!--components/emotionSummaryCard/index.wxml-->
<view class="emotion-summary-container" wx:if="{{show}}" catchtouchmove="true">
  <!-- 背景遮罩 -->
  <view class="backdrop" bindtap="onClose"></view>

  <!-- 卡片容器 -->
  <view class="card-container" catchtap="preventClose">
    <!-- 情绪标签气泡 -->
    <view class="tag-bubble">
      <text class="tag-text">{{tag}}</text>
    </view>

    <!-- 摘要内容卡片 -->
    <view class="content-card">
      <text class="content-text">{{content}}</text>
    </view>

    <!-- 分享按钮 -->
    <view class="share-btn" bindtap="onShare">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <polyline points="16,6 12,2 8,6" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="12" y1="2" x2="12" y2="15" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <text class="share-text">传播这份情感</text>
    </view>
  </view>
</view>
