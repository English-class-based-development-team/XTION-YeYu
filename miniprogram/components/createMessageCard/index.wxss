/* components/createMessageCard/index.wxss */

/* 模态框容器 */
.create-message-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.create-message-modal.show {
  opacity: 1;
}

/* 背景遮罩 */
.backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(8rpx);
}

/* 卡片容器 */
.card-container {
  position: relative;
  width: 90%;
  max-width: 640rpx; /* max-w-md = 28rem = 448px × 2 / 1.4 ≈ 640rpx */
  padding: 40rpx;
  animation: card-entrance 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes card-entrance {
  0% {
    transform: scale(0.8) translateY(100rpx);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* 情绪标签气泡 */
.tag-bubble {
  margin-bottom: 24rpx; /* mb-3 = 12px × 2 */
  padding: 20rpx 40rpx; /* py-2.5 px-5 = 10px 20px × 2 */
  background: linear-gradient(to right, #ff9966, #ff8855);
  border-radius: 36rpx; /* rounded-[18px] = 18px × 2 */
  box-shadow: 0 8rpx 24rpx rgba(255, 153, 102, 0.3);
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
  animation: tag-entrance 0.4s ease 0.2s backwards;
}

@keyframes tag-entrance {
  0% {
    transform: translateY(40rpx);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.tag-bubble:active {
  transform: scale(0.98);
}

.tag-text {
  color: #ffffff;
  font-size: 28rpx; /* text-sm = 14px × 2 */
  font-weight: 600; /* font-semibold */
}

.tag-editing {
  padding: 0;
}

.tag-input {
  width: 100%;
  height: 100%;
  padding: 20rpx 40rpx;
  background: transparent;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  outline: none;
}

/* 内容卡片 */
.content-card {
  position: relative;
  background: #ffffff;
  border-radius: 64rpx; /* rounded-[32px] = 32px × 2 */
  padding: 64rpx; /* p-8 = 32px × 2 */
  min-height: 360rpx; /* min-h-[180px] = 180px × 2 */
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.08);
  cursor: pointer;
  animation: content-entrance 0.4s ease 0.3s backwards;
}

@keyframes content-entrance {
  0% {
    transform: translateY(60rpx);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.content-display {
  width: 100%;
  min-height: 232rpx; /* 360rpx - 64rpx * 2 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.content-text {
  color: #2a1a4d;
  font-size: 32rpx; /* text-base = 16px × 2 */
  line-height: 1.6; /* leading-relaxed */
  text-align: center;
  word-break: break-word;
}

.content-text.placeholder {
  color: rgba(42, 26, 77, 0.4);
}

.content-textarea {
  width: 100%;
  min-height: 232rpx;
  color: #2a1a4d;
  font-size: 32rpx;
  line-height: 1.6;
  text-align: center;
  border: none;
  outline: none;
  background: transparent;
}

.content-placeholder {
  color: rgba(42, 26, 77, 0.4);
  text-align: center;
}

.character-count {
  position: absolute;
  bottom: 24rpx;
  right: 32rpx;
  font-size: 24rpx;
}

.count-text {
  color: rgba(42, 26, 77, 0.5);
}

.count-text.warning {
  color: #e54545;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 40rpx; /* mt-5 = 20px × 2 */
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx; /* gap-2.5 = 10px × 2 */
  padding: 32rpx 64rpx; /* py-4 px-8 = 16px 32px × 2 */
  background: linear-gradient(to right, #E89B6D, #F3B89A);
  border-radius: 48rpx; /* rounded-[24px] = 24px × 2 */
  box-shadow: 0 8rpx 24rpx rgba(232, 155, 109, 0.3);
  border: none;
  outline: none;
  transition: all 0.2s ease;
  animation: button-entrance 0.4s ease 0.4s backwards;
}

@keyframes button-entrance {
  0% {
    transform: translateY(40rpx);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.submit-btn:active {
  transform: scale(0.95);
}

.submit-btn.disabled {
  opacity: 0.5;
}

.submit-icon {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 1;
}

.submit-text {
  color: #ffffff;
  font-size: 32rpx; /* text-base = 16px × 2 */
  font-weight: 600; /* font-semibold */
}

/* 按钮 after 伪类（微信小程序不支持，使用 view 替代） */
.submit-btn::after {
  border: none;
}
