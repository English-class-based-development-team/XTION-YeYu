<!--components/createMessageCard/index.wxml-->
<view 
  class="create-message-modal {{animationClass}}" 
  wx:if="{{show}}"
  catchtouchmove="true"
>
  <!-- 背景遮罩 -->
  <view class="backdrop" bindtap="onBackdropClick"></view>

  <!-- 卡片容器 -->
  <view class="card-container" catchtap="preventClose">
    <!-- 情绪标签选择器容器 -->
    <view class="tag-selector-container">
      <!-- 当前选中的标签气泡 -->
      <view class="tag-bubble {{isTagSelectorExpanded ? 'expanded' : ''}}" bindtap="onTagBubbleClick">
        <text class="tag-text">{{tag}}</text>
        <text class="tag-icon {{isTagSelectorExpanded ? 'rotated' : ''}}">▼</text>
      </view>

      <!-- 展开的标签列表 -->
      <view class="tag-options {{isTagSelectorExpanded ? 'show' : ''}}" wx:if="{{isTagSelectorExpanded}}">
        <view 
          class="tag-option {{selectedTagIndex === index ? 'selected' : ''}}"
          wx:for="{{emotionTagsArray}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="onSelectTag"
        >
          <text class="tag-option-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 内容卡片（可编辑） -->
    <view class="content-card" bindtap="onContentClick">
      <!-- 非编辑模式 -->
      <view class="content-display" wx:if="{{!isEditingContent}}">
        <text class="content-text {{content === '' || content === contentPlaceholder ? 'placeholder' : ''}}">
          {{content === '' ? contentPlaceholder : content}}
        </text>
      </view>

      <!-- 编辑模式 -->
      <textarea 
        wx:if="{{isEditingContent}}"
        class="content-textarea"
        value="{{content}}"
        placeholder="{{contentPlaceholder}}"
        placeholder-class="content-placeholder"
        maxlength="300"
        auto-height
        focus="{{isEditingContent}}"
        bindinput="onContentInput"
        bindblur="onContentBlur"
        bindfocus="onContentFocus"
      ></textarea>

      <!-- 字数统计（仅编辑模式显示） -->
      <view class="character-count" wx:if="{{isEditingContent}}">
        <text class="count-text {{contentLength >= 300 ? 'warning' : ''}}">
          {{contentLength}}/300
        </text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button
      class="submit-btn {{canSubmit ? '' : 'disabled'}}"
      disabled="{{!canSubmit}}"
      loading="{{isSubmitting}}"
      bindtap="onSubmit"
    >
      <svg wx:if="{{!isSubmitting}}" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="m22 2-7 20-4-9-9-4 20-7z" fill="white"/>
        <path d="m22 2-7 20-4-9-9-4 20-7z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <text class="submit-text">{{isSubmitting ? '发送中...' : '发送到漂流瓶'}}</text>
    </button>
  </view>
</view>
