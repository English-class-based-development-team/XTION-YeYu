<!--components/proactiveCare/index.wxml-->
<view class="proactive-care" wx:if="{{show}}">
  <view class="care-message-container {{animationClass}}">
    <!-- 小红心图标 -->
    <view class="heart-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="#ff9966" stroke="#ff9966" stroke-width="1"/>
      </svg>
    </view>
    
    <!-- 消息气泡 -->
    <view class="message-bubble">
      <text class="message-text">{{currentMessage}}</text>
    </view>
    
    <!-- 进度指示器 -->
    <view class="progress-dots">
      <view 
        class="dot {{index === currentIndex ? 'active' : ''}}"
        wx:for="{{messages}}"
        wx:key="index"
        wx:for-index="index"
      ></view>
    </view>
  </view>
</view>

