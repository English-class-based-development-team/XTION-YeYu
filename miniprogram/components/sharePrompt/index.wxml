<!--components/sharePrompt/index.wxml-->
<view class="share-prompt" wx:if="{{show}}" bindtap="onClick">
  <!-- 瓶子图标 SVG -->
  <view class="bottle-icon">
    <svg width="56" height="56" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="bottleIconGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="white" stop-opacity="0.9" />
          <stop offset="100%" stop-color="white" stop-opacity="0.6" />
        </linearGradient>
      </defs>
      <!-- Cork -->
      <rect x="10" y="4" width="8" height="4" rx="2" fill="#8B5A3C" />
      <!-- Bottle neck -->
      <rect x="11" y="7" width="6" height="5" rx="1" fill="url(#bottleIconGrad)" />
      <!-- Main bottle body -->
      <rect x="7" y="11" width="14" height="12" rx="4" fill="url(#bottleIconGrad)" />
      <!-- Shine effect -->
      <ellipse cx="11" cy="15" rx="3" ry="4" fill="white" opacity="0.5" />
    </svg>
  </view>
  <text class="share-text">传播你的共鸣!</text>
</view>
