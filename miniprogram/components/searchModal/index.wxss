/* components/searchModal/index.wxss */

.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0 40rpx;
  padding-top: 192rpx;
}

/* 背景遮罩 */
.backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.2);
  opacity: 0;
}

/* 注意：小程序不支持backdrop-filter，这里使用半透明背景代替 */

/* 内容盒子 */
.modal-content {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 600rpx;
  opacity: 0;
  transform: scale(0.9) translateY(-40rpx);
}

.search-box {
  background-color: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 48rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.title {
  color: #2a1a4d;
  font-size: 36rpx;
  font-weight: 600;
}

.close-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s;
}

.close-btn:active {
  background-color: #f3f4f6;
  transform: scale(0.95);
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 输入区域 */
.input-section {
  padding: 48rpx;
}

/* 搜索输入框 */
.search-input-wrapper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background-color: #f9fafb;
  border-radius: 36rpx;
  padding: 32rpx 40rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2a1a4d;
  background-color: transparent;
}

.input-placeholder {
  color: rgba(42, 26, 77, 0.4);
}

/* 搜索按钮 */
.search-btn {
  width: 100%;
  margin-top: 32rpx;
  padding: 32rpx 0;
  background: linear-gradient(to right, #E89B6D, #F3B89A);
  border-radius: 36rpx;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  border: none;
  transition: all 0.3s;
}

.search-btn::after {
  border: none;
}

.search-btn:active {
  transform: scale(0.98);
  box-shadow: 0 15px 20px -3px rgba(0, 0, 0, 0.15);
}

.search-btn.disabled {
  opacity: 0.5;
}

.search-btn-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

/* 示例搜索 */
.examples-section {
  margin-top: 48rpx;
}

.examples-title {
  color: rgba(42, 26, 77, 0.6);
  font-size: 28rpx;
  display: block;
  margin-bottom: 24rpx;
}

.examples-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.example-tag {
  padding: 16rpx 32rpx;
  background: linear-gradient(to right, rgba(255, 153, 102, 0.1), rgba(255, 136, 85, 0.1));
  border-radius: 999rpx;
  transition: all 0.2s;
}

.example-tag:active {
  transform: scale(0.95);
  background: linear-gradient(to right, rgba(255, 153, 102, 0.2), rgba(255, 136, 85, 0.2));
}

.example-tag-text {
  color: #E89B6D;
  font-size: 28rpx;
}

