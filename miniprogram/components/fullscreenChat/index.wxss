/* components/fullscreenChat/index.wxss */

.fullscreen-chat-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
}

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.4);
  /* backdrop-filter: blur(60rpx); */ /* 微信不支持，使用替代方案 */
}

.content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: rgba(255, 255, 255, 0.4);
}

/* 头部 */
.header {
  padding: 40rpx 48rpx;
  border-bottom: 1px solid rgba(42, 26, 77, 0.1);
  background: rgba(255, 255, 255, 0.5);
  max-width: 1344rpx; /* max-w-2xl = 672px × 2 = 1344rpx */
  margin: 0 auto;
  width: 100%;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.back-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background-color 0.2s, transform 0.2s;
}

.back-btn:active {
  background: #f5f5f5;
  transform: scale(0.95);
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.header-title {
  color: #2a1a4d;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.header-subtitle {
  color: rgba(42, 26, 77, 0.5);
  font-size: 28rpx;
  margin-top: 8rpx;
}

/* 消息区域 */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 48rpx 40rpx;
  display: flex;
  justify-content: center;
}

.messages-wrapper {
  max-width: 1344rpx; /* max-w-2xl = 672px × 2 = 1344rpx */
  width: 100%;
  position: relative;
  left: -30rpx; /* 稍微往左移，视觉上更居中对称 */
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  animation: messageFadeIn 0.4s ease-out;
}

.message-item.message-user {
  justify-content: flex-end;
}

.message-item.message-ai {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 75%;
  padding: 32rpx 48rpx; /* px-6 py-4 = 24px 16px × 2 = 48rpx 32rpx */
  border-radius: 48rpx; /* rounded-[24px] = 24px × 2 = 48rpx */
}

.message-user .message-bubble {
  background: #ff9966;
  color: white; /* text-white */
  border-radius: 48rpx 48rpx 24rpx 48rpx; /* rounded-[24px] rounded-br-lg */
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); /* shadow-md */
}

.message-ai .message-bubble {
  background: #ffe8d9; /* bg-[#ffe8d9] */
  color: #2a1a4d; /* text-[#2a1a4d] */
  border-radius: 48rpx 48rpx 48rpx 24rpx; /* rounded-[24px] rounded-bl-lg */
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); /* shadow-sm */
}

.message-text {
  font-size: 32rpx;
  line-height: 1.6;
}

.message-user .message-text {
  color: white;
}

.message-ai .message-text {
  color: #2a1a4d;
}

.messages-end {
  height: 20rpx;
}

/* 输入区域 */
.input-area {
  padding: 48rpx 40rpx;
  border-top: 1px solid rgba(42, 26, 77, 0.1);
  background: rgba(255, 255, 255, 0.5);
  display: flex;
  justify-content: center;
}

.input-wrapper {
  max-width: 1344rpx; /* max-w-2xl = 672px × 2 = 1344rpx */
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  position: relative;
  left: -30rpx; /* 稍微往左移，与消息区域对齐 */
}

.share-prompt-wrapper {
  display: flex;
  justify-content: center;
}

.input-box {
  display: flex;
  align-items: center;
  gap: 24rpx; /* gap-3 = 12px × 2 = 24rpx */
  background: white;
  border-radius: 52rpx; /* rounded-[26px] = 26px × 2 = 52rpx */
  padding: 32rpx 48rpx; /* py-4 px-6 = 16px 24px × 2 = 32rpx 48rpx */
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); /* shadow-md */
  border: 1px solid rgba(229, 231, 235, 1); /* border-gray-100 */
  max-width: 900rpx; /* 限制输入框最大宽度，使其更紧凑 */
  margin: 0 auto; /* 居中显示 */
}

.input-field {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  font-size: 32rpx;
  color: #2a1a4d;
}

.input-placeholder {
  color: rgba(42, 26, 77, 0.3); /* placeholder:text-[#2a1a4d]/30 */
}

.send-btn {
  width: 88rpx; /* w-11 = 44px × 2 = 88rpx */
  height: 88rpx; /* h-11 = 44px × 2 = 88rpx */
  border-radius: 44rpx; /* rounded-full = 50% */
  background: #ff9966;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); /* shadow-md */
  transition: background-color 0.2s, opacity 0.2s, transform 0.2s;
}

.send-btn:active {
  background: #ff8855; /* hover:bg-[#ff8855] */
  transform: scale(0.95); /* active:scale-95 */
}

.send-btn.disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.send-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 加载动画 */
.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 动画 */
@keyframes messageFadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.prevent-close {
  /* 防止事件冒泡 */
}
