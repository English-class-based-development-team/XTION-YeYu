/* components/fullscreenChat/index.wxss */

.fullscreen-chat-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
}

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.4);
  /* backdrop-filter: blur(60rpx); */ /* 微信不支持，使用替代方案 */
}

.content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: rgba(255, 255, 255, 0.4);
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 48rpx;
  border-bottom: 1px solid rgba(42, 26, 77, 0.1);
  background: rgba(255, 255, 255, 0.5);
}

.header-left {
  display: flex;
  flex-direction: column;
}

.header-title {
  color: #2a1a4d;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.header-subtitle {
  color: rgba(42, 26, 77, 0.5);
  font-size: 28rpx;
  margin-top: 8rpx;
}

.close-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s;
}

.close-btn:active {
  background: #f5f5f5;
  transform: scale(0.95);
}

.close-icon {
  color: #2a1a4d;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* 消息区域 */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 48rpx 40rpx;
}

.messages-wrapper {
  max-width: 1000rpx;
  margin: 0 auto;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  animation: messageFadeIn 0.4s ease-out;
}

.message-item.message-user {
  justify-content: flex-end;
}

.message-item.message-ai {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 75%;
  padding: 32rpx 48rpx;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.message-user .message-bubble {
  background: #ff9966;
  border-radius: 48rpx 48rpx 16rpx 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.message-ai .message-bubble {
  background: #ffe8d9;
  border-radius: 48rpx 48rpx 48rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.message-text {
  font-size: 32rpx;
  line-height: 1.6;
}

.message-user .message-text {
  color: white;
}

.message-ai .message-text {
  color: #2a1a4d;
}

.messages-end {
  height: 20rpx;
}

/* 输入区域 */
.input-area {
  padding: 48rpx 40rpx;
  border-top: 1px solid rgba(42, 26, 77, 0.1);
  background: rgba(255, 255, 255, 0.5);
}

.input-wrapper {
  max-width: 1000rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.share-prompt-wrapper {
  display: flex;
  justify-content: center;
}

.input-box {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: white;
  border-radius: 52rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.input-field {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  font-size: 32rpx;
  color: #2a1a4d;
}

.input-placeholder {
  color: rgba(42, 26, 77, 0.3);
}

.send-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff9966;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s, opacity 0.2s;
}

.send-btn:active {
  background: #ff8855;
  transform: scale(0.95);
}

.send-btn.disabled {
  opacity: 0.3;
}

.send-icon {
  color: white;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

/* 动画 */
@keyframes messageFadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.prevent-close {
  /* 防止事件冒泡 */
}
