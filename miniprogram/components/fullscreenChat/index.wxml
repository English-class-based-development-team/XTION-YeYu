<!--components/fullscreenChat/index.wxml-->
<view class="fullscreen-chat-container" wx:if="{{show}}" catchtouchmove="preventDefault">
  <!-- 背景遮罩 -->
  <view class="backdrop" bindtap="onClose"></view>
  
  <!-- 内容区域 -->
  <view class="content">
    <!-- 头部 -->
    <view class="header">
      <view class="header-content">
        <!-- 返回按钮 -->
        <view class="back-btn" bindtap="onClose">
          <image class="back-icon" src="/images/icons/arrow-left.svg" mode="aspectFit"></image>
        </view>
        <!-- 标题区域 -->
        <view class="header-text">
          <text class="header-title">Conversation</text>
          <text class="header-subtitle">Psychology Agent</text>
        </view>
      </view>
    </view>

    <!-- 消息区域 -->
    <scroll-view 
      class="messages-container" 
      scroll-y="true"
      scroll-top="{{scrollTop}}"
      scroll-with-animation="true"
      scroll-into-view="{{scrollToView}}"
      enable-flex="{{true}}"
    >
      <view class="messages-wrapper">
        <view 
          class="message-item {{item.isUser ? 'message-user' : 'message-ai'}}"
          wx:for="{{messages}}" 
          wx:key="id"
        >
          <view class="message-bubble">
            <text class="message-text">{{item.text || item.content}}</text>
          </view>
        </view>
        <view class="messages-end" id="messages-end"></view>
        <view id="scroll-end"></view>
      </view>
    </scroll-view>

    <!-- 输入区域 -->
    <view class="input-area">
      <view class="input-wrapper">
        <!-- SharePrompt 按钮 - 消息 > 3 时显示 -->
        <view class="share-prompt-wrapper" wx:if="{{messages.length > 3}}">
          <share-prompt bindclick="onSharePromptClick"></share-prompt>
        </view>

        <!-- 输入框 -->
        <view class="input-box">
          <input
            class="input-field"
            type="text"
            value="{{input}}"
            placeholder="Type your message..."
            placeholder-class="input-placeholder"
            bindinput="onInput"
            bindconfirm="onConfirm"
            focus="{{show && messages.length > 0}}"
            disabled="{{isLoading}}"
          />
          <view 
            class="send-btn {{input && !isLoading ? '' : 'disabled'}}"
            bindtap="onSend"
          >
            <!-- 加载状态显示 -->
            <view wx:if="{{isLoading}}" class="loading-spinner"></view>
            <!-- 发送图标：折纸飞机图标 -->
            <image wx:else class="send-icon" src="/images/icons/send.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- EmotionSummaryCard 模态框 -->
  <emotion-summary-card
    show="{{showEmotionCard}}"
    bindclose="onEmotionCardClose"
    bindshare="onEmotionCardShare"
    bindstartresonance="onEmotionCardShare"
  ></emotion-summary-card>
</view>
